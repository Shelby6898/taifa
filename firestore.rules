rules_version = '2';

// All client-side (non-Admin SDK) access to Firestore is intentionally denied.
// Taifatech's frontend never talks to Firestore directly — every read and
// write goes through the Express API (server.js / src/controllers), which
// uses the Firebase Admin SDK and is therefore unaffected by these rules.
//
// This blocks any attempt to read or write Firestore directly using the
// public Firebase client config (API keys in frontend JS are not secret —
// they are always visible in browser dev tools, so this rule is the actual
// security boundary, not the API key itself).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
